#version 460
#extension GL_EXT_ray_tracing         : require
#extension GL_EXT_buffer_reference    : require
#extension GL_EXT_scalar_block_layout : require

#include "utils/common.glsl"
#include "utils/math.glsl"
#include "utils/eval.glsl"
#include "utils/spherical-harmonics.glsl"
#include "utils/fisheye.glsl"
#include "utils/dof.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba16f) uniform image2D outputImage;
layout(set = 0, binding = 2) uniform SceneUBO
{
    SceneBounds sceneBounds;
};
layout(set = 0, binding = 3) uniform accelerationStructureEXT meshTlas;

layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer PositionBuffer
{
    vec3 data[];
};
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer ColorBuffer
{
    vec4 data[];
};
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer QuaternionBuffer
{
    vec4 data[];
};
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer ScaleBuffer
{
    vec3 data[];
};
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer SHCoefficientsBuffer
{
    uint data[];
};

layout(push_constant) uniform PushConstants
{
    Camera               camera;            // 192 bytes
    PositionBuffer       positionBuffer;    //   8 bytes (BDA)
    ColorBuffer          colorBuffer;       //   8 bytes (BDA)
    QuaternionBuffer     quaternionBuffer;  //   8 bytes (BDA)
    ScaleBuffer          scaleBuffer;       //   8 bytes (BDA)
    SHCoefficientsBuffer shBuffer;          //   8 bytes (BDA)
};

layout(location = 0) rayPayloadEXT HitArrayPayload payload;
layout(location = 1) rayPayloadEXT MeshHitPayload meshPayload;

const int   MAX_ITERATIONS              = 64;          // Maximum tracing iterations
const float T_EPSILON                   = 1e-5;        // Epsilon for tMin advancement (nvpro: 1e-9)
const float MIN_PARTICLE_KERNEL_DENSITY = 0.0113;      // min_response (official: 0.0113)
const float MIN_PARTICLE_ALPHA          = 0.00392157;  // min_alpha = 1/255

// trace.glsl depends on global declarations and constants above (tlas, payload, buffers, etc.),
// so it must be included after all layout declarations and constant definitions.
#include "utils/trace.glsl"


void main()
{
    const uvec2 pixelCoord = gl_LaunchIDEXT.xy;
    const uvec2 launchSize = gl_LaunchSizeEXT.xy;

    // Compute normalized device coordinates (NDC)
    const vec2 pixelCenter = vec2(pixelCoord) + vec2(0.5);

    vec3 rayOrigin;
    vec3 rayDirection;

    if (camera.cameraType == 0)  // Pinhole
    {
        const vec2 uv  = pixelCenter / vec2(launchSize);
        const vec2 ndc = uv * 2.0 - 1.0;

        vec4 origin    = camera.viewInverse * vec4(0.0, 0.0, 0.0, 1.0);
        vec4 target    = camera.projInverse * vec4(ndc.x, ndc.y, 1.0, 1.0);
        target        /= target.w;
        vec4 direction = camera.viewInverse * vec4(normalize(target.xyz), 0.0);

        rayOrigin    = origin.xyz;
        rayDirection = normalize(direction.xyz);
    }
    else if (camera.cameraType == 1)  // Fisheye
    {
        vec3 dirLocal = computeFisheyeRayDirection(
            pixelCenter, 
            vec2(launchSize),
            camera.fisheyeFov,
            camera.fisheyeMaxAngle,
            camera.fisheyeCx,
            camera.fisheyeCy,
            camera.fisheyeK1,
            camera.fisheyeK2,
            camera.fisheyeK3,
            camera.fisheyeK4
        );

        if (dirLocal == vec3(0.0))
        {
            imageStore(outputImage, ivec2(pixelCoord), vec4(0.0, 0.0, 0.0, 1.0));
            return;
        }

        rayOrigin    = (camera.viewInverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
        rayDirection = normalize((camera.viewInverse * vec4(dirLocal, 0.0)).xyz);
    }

    if (camera.enableDoF > 0 && camera.aperture > 0.0)
    {
        uint seed = pcgHash(pixelCoord.y * launchSize.x + pixelCoord.x + camera.frameIndex * 1009u);

        vec3 doFOrigin, doFDirection;
        computeDoFRay(
            rayOrigin, 
            rayDirection, 
            camera.aperture, 
            camera.focalDistance,
            camera.viewInverse, 
            seed, 
            doFOrigin, 
            doFDirection
        );

        rayOrigin    = doFOrigin;
        rayDirection = doFDirection;
    }

    vec3  radiance      = vec3(0.0);
    float transmittance = 1.0;
    float depth         = 0.0;

    float tMin = camera.nearPlane;
    float tMax = camera.farPlane;

    vec3 currentOrigin    = rayOrigin;
    vec3 currentDirection = rayDirection;

    bool needMeshTrace = (sceneBounds.enableReflection > 0 || sceneBounds.meshCount > 0);
    uint maxBounces    = needMeshTrace ? min(sceneBounds.maxBounces, MAX_BOUNCES) : 0u;

    for (uint bounce = 0; bounce <= maxBounces; ++bounce)
    {
        if (transmittance <= TRANSMITTANCE_THRESHOLD)
        {
            break;
        }

        float meshHitDist = INFINITE_DISTANCE;

        if (needMeshTrace && sceneBounds.meshCount > 0)
        {
            meshPayload.hitDist      = INFINITE_DISTANCE;
            meshPayload.materialType = MATERIAL_DIFFUSE;

            traceRayEXT(
                meshTlas,
                gl_RayFlagsNoneEXT,
                0xFF,
                0, 0, 0,
                currentOrigin,
                tMin,
                currentDirection,
                tMax,
                1
            );

            meshHitDist = meshPayload.hitDist;
        }

        float gaussianTMax = min(tMax, meshHitDist);
        int   maxIter      = (bounce == 0) ? MAX_ITERATIONS : MAX_REFLECTION_ITERATIONS;

        traceGaussians(
            currentOrigin, 
            currentDirection,
            tMin, 
            gaussianTMax, 
            maxIter,
            radiance, 
            transmittance, 
            depth
        );

        if (meshHitDist >= INFINITE_DISTANCE)
        {
            break;  // No mesh — end bounce loop
        }

        vec3 litColor = computeLighting(
            meshPayload.color, meshPayload.normal, currentDirection,
            sceneBounds.lightDir, sceneBounds.lightColor, sceneBounds.lightIntensity,
            sceneBounds.ambientColor, sceneBounds.ambientIntensity,
            sceneBounds.enableSpecular > 0, sceneBounds.specularShininess
        );

        if (meshPayload.materialType == MATERIAL_REFLECTIVE)
        {
            vec3  reflDir     = reflect(currentDirection, meshPayload.normal);
            float reflWeight  = meshPayload.reflectivity * transmittance;
            float diffWeight  = (1.0 - meshPayload.reflectivity) * transmittance;

            radiance       += litColor * diffWeight;
            transmittance   = reflWeight;

            currentOrigin    = currentOrigin + meshHitDist * currentDirection
                             + meshPayload.normal * T_EPSILON;
            currentDirection = reflDir;
            tMin             = 0.0;
        }
        else
        {
            radiance     += litColor * transmittance;
            transmittance = 0.0;
            break;
        }
    }

    // Shadow: mesh casts shadow onto Gaussian particles
    if (sceneBounds.enableShadow > 0 && sceneBounds.meshCount > 0)
    {
        float totalOpacity = 1.0 - transmittance;
        if (totalOpacity > 0.05)
        {
            // Approximate Gaussian surface point (weighted average depth)
            float avgDepth     = depth / max(totalOpacity, 0.001);
            vec3  surfacePoint = rayOrigin + avgDepth * rayDirection;

            // Trace shadow ray toward light direction (mesh TLAS only)
            meshPayload.hitDist = INFINITE_DISTANCE;
            traceRayEXT(
                meshTlas,
                gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
                0xFF,
                0, 0, 0,
                surfacePoint,
                T_EPSILON,
                normalize(-sceneBounds.lightDir),
                100.0,
                1
            );

            // Mesh blocks light → darken proportional to Gaussian density
            if (meshPayload.hitDist < INFINITE_DISTANCE)
            {
                float shadowFactor = mix(1.0, sceneBounds.shadowIntensity, totalOpacity);
                radiance *= shadowFactor;
            }
        }
    }

    // Apply render mode
    vec3 finalColor = radiance;
    if (sceneBounds.renderMode == RENDER_MODE_DEPTH)
    {
        // Normalize depth: 0 = near, 1 = far
        float d = clamp(depth / sceneBounds.tMax, 0.0, 1.0);

        // Heatmap: near(0) = red/warm, far(1) = blue/cool
        float t = 1.0 - d;  // invert so near=1, far=0
        finalColor.r = clamp(1.5 - abs(t - 0.75) * 4.0, 0.0, 1.0);
        finalColor.g = clamp(1.5 - abs(t - 0.50) * 4.0, 0.0, 1.0);
        finalColor.b = clamp(1.5 - abs(t - 0.25) * 4.0, 0.0, 1.0);
    }

    imageStore(outputImage, ivec2(pixelCoord), vec4(finalColor, 1.0));
}
